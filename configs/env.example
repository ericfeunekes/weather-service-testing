# Copy values into your shell or a local ignored environment file. Do not commit credentials.
WX_LAT=<latitude>
WX_LON=<longitude>
WX_TZ=<IANA_timezone>

# Set only the providers you use.
WX_OPENWEATHER_API_KEY=<openweather_api_key>
WX_TOMORROW_IO_API_KEY=<tomorrow_io_api_key>
WX_ACCUWEATHER_API_KEY=<accuweather_api_key>
WX_AMBIENT_API_KEY=<ambient_api_key>
WX_AMBIENT_APPLICATION_KEY=<ambient_application_key>
WX_AMBIENT_DEVICE_MAC=<ambient_device_mac>
WX_ECOWITT_API_KEY=<ecowitt_api_key>
WX_ECOWITT_APPLICATION_KEY=<ecowitt_application_key>
WX_ECOWITT_DEVICE_MAC=<ecowitt_device_mac>
WX_ECOWITT_STATION=<ecowitt_station>
WX_WEATHERKIT_TEAM_ID=<weatherkit_team_id>
WX_WEATHERKIT_SERVICE_ID=<weatherkit_service_id>
WX_WEATHERKIT_KEY_ID=<weatherkit_key_id>
WX_WEATHERKIT_KEY_PATH=<weatherkit_private_key_path>
WX_WEATHERKIT_COUNTRY_CODE=CA
WX_GOOGLE_MAPS_API_KEY=<google_maps_api_key>

# Read by the launchd runner. For direct CLI use, pass the same value with --target.
WX_SYNC_TARGET=<rsync_destination>
